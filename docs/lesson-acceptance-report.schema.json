{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdenZC/codex-work-skills/blob/master/docs/lesson-acceptance-report.schema.json",
  "title": "Lesson Acceptance 2.0 Report (Content 2.0/2.1/2.2/2.3)",
  "type": "object",
  "required": [
    "acceptance_schema_version",
    "metadata",
    "structural_hard_gates",
    "content_quality_evidence",
    "sequence_review",
    "course_scope_review",
    "content_length",
    "visual_review",
    "negative_controls",
    "hallucination_review",
    "teaching_design_review",
    "teacher_usability",
    "final_status"
  ],
  "properties": {
    "acceptance_schema_version": { "const": "2.0" },
    "metadata": {
      "type": "object",
      "required": [
        "course",
        "major",
        "audience",
        "lesson_count",
        "total_hours",
        "source_type",
        "master_commit",
        "content_contract_version",
        "template_version",
        "input_sha256",
        "qa_report_sha256",
        "output_inventory_fingerprint",
        "render_status",
        "visual_status"
      ],
      "properties": {
        "source_type": {
          "enum": ["real_agent", "synthetic_fixture", "human_authored", "mixed"]
        },
        "content_contract_version": { "enum": ["2.0", "2.1", "2.2", "2.3"] },
        "template_version": { "const": "v1.1.2" },
        "lesson_count": { "type": "integer", "minimum": 0 },
        "total_hours": { "type": ["number", "null"] },
        "input_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "qa_report_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "output_inventory_fingerprint": { "type": ["string", "null"] },
        "production_status": { "enum": ["production_pass", "structural_pass", "failed", "not_applicable"] },
        "delivery_mode": { "type": ["string", "null"] },
        "theory_hours": { "type": ["number", "null"] },
        "practice_hours": { "type": ["number", "null"] },
        "lesson_coverage_hours": { "type": ["number", "null"] },
        "lesson_type_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": true
    },
    "structural_hard_gates": {
      "type": "object",
      "required": ["status", "hard_gate", "gates"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "hard_gate": { "const": true },
        "gates": { "type": "array" }
      },
      "additionalProperties": true
    },
    "benchmark_review": {
      "type": "object",
      "required": [
        "status", "decision", "review_round", "major_gap_count", "minor_gap_count",
        "insufficient_evidence_count", "lessons_reviewed", "lessons_without_holdout",
        "context_mode", "authoring_availability", "holdout_availability",
        "benchmark_run_id", "source_sha256", "catalog_fingerprint", "split_fingerprint",
        "authoring_pack_fingerprint", "authoring_selection_sha256",
        "holdout_pack_fingerprint", "holdout_selection_sha256",
        "benchmark_authorization_sha256", "no_relevant_holdout_lesson_count", "review_sha256"
      ],
      "properties": {
        "status": { "enum": ["BENCHMARK_REVIEW_COMPLETE", "BENCHMARK_GAPS_FOUND", "BENCHMARK_PARTIAL", "BENCHMARK_UNAVAILABLE", "HUMAN_REVIEW_REQUIRED"] },
        "decision": { "enum": ["NO_REVISION_REQUIRED", "REVISION_REQUIRED", "HUMAN_REVIEW_REQUIRED", "BENCHMARK_PARTIAL", "BENCHMARK_UNAVAILABLE"] },
        "review_round": { "enum": [1, 2] },
        "major_gap_count": { "type": "integer", "minimum": 0 },
        "minor_gap_count": { "type": "integer", "minimum": 0 },
        "insufficient_evidence_count": { "type": "integer", "minimum": 0 },
        "lessons_reviewed": { "type": "integer", "minimum": 0 },
        "lessons_without_holdout": { "type": "integer", "minimum": 0 },
        "context_mode": { "enum": ["separate_contexts", "single_context"] },
        "authoring_availability": { "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE"] },
        "holdout_availability": { "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE"] },
        "benchmark_run_id": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "catalog_fingerprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "split_fingerprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "authoring_pack_fingerprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "authoring_selection_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "holdout_pack_fingerprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "holdout_selection_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "benchmark_authorization_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "no_relevant_holdout_lesson_count": { "type": "integer", "minimum": 0 },
        "review_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "review_completeness": {
          "type": "object",
          "required": ["status", "issues"],
          "properties": {
            "status": { "enum": ["complete", "pending", "failed"] },
            "issues": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "delivery_metrics": { "type": "object", "additionalProperties": true },
    "reference_metrics": { "type": "object", "additionalProperties": true },
    "practice_handoff_metrics": { "type": "object", "additionalProperties": true },
    "manual_completion_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "visual_review",
          "teaching_design_review",
          "teacher_usability",
          "course_scope_review",
          "hallucination_review",
          "benchmark_review"
        ]
      }
    },
    "final_status": {
      "enum": [
        "PENDING_MANUAL_REVIEW",
        "PASSED",
        "PASSED_WITH_TEACHER_ADJUSTMENTS",
        "FAILED"
      ]
    }
  },
  "additionalProperties": true
}
