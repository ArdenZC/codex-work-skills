{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reviewer-configuration 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configuration_version",
    "reviewer_type",
    "implementation",
    "version",
    "implementation_build_sha256",
    "context_policy",
    "agent",
    "human"
  ],
  "properties": {
    "configuration_version": {
      "const": "1.0"
    },
    "reviewer_type": {
      "enum": [
        "agent",
        "human"
      ]
    },
    "implementation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "implementation_build_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "whole_course",
        "verified_sources_only",
        "author_reasoning_hidden",
        "candidate_read_only"
      ],
      "properties": {
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "whole_course": {
          "const": true
        },
        "verified_sources_only": {
          "const": true
        },
        "author_reasoning_hidden": {
          "const": true
        },
        "candidate_read_only": {
          "const": true
        }
      }
    },
    "agent": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_reference",
            "model_revision",
            "provider_reference",
            "semantic_prompt_sha256",
            "system_instructions_sha256",
            "decoding",
            "tool_permissions_sha256"
          ],
          "properties": {
            "model_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "model_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "provider_reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "semantic_prompt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "system_instructions_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "decoding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "temperature",
                "top_p",
                "seed",
                "max_output_tokens",
                "additional_parameters"
              ],
              "properties": {
                "temperature": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "top_p": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "seed": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "additional_parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "value"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "\\S"
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 600
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "minItems": 0
                }
              }
            },
            "tool_permissions_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "human": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "procedure_id",
            "procedure_version",
            "procedure_sha256",
            "interface_policy_sha256"
          ],
          "properties": {
            "procedure_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "procedure_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "procedure_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "interface_policy_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "reviewer_type": {
          "const": "agent"
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_reference",
            "model_revision",
            "provider_reference",
            "semantic_prompt_sha256",
            "system_instructions_sha256",
            "decoding",
            "tool_permissions_sha256"
          ],
          "properties": {
            "model_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "model_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "provider_reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "semantic_prompt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "system_instructions_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "decoding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "temperature",
                "top_p",
                "seed",
                "max_output_tokens",
                "additional_parameters"
              ],
              "properties": {
                "temperature": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "top_p": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "seed": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "additional_parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "value"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "\\S"
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 600
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "minItems": 0
                }
              }
            },
            "tool_permissions_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "human": {
          "const": null
        }
      }
    },
    {
      "properties": {
        "reviewer_type": {
          "const": "human"
        },
        "agent": {
          "const": null
        },
        "human": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "procedure_id",
            "procedure_version",
            "procedure_sha256",
            "interface_policy_sha256"
          ],
          "properties": {
            "procedure_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "procedure_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "procedure_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "interface_policy_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  ]
}
