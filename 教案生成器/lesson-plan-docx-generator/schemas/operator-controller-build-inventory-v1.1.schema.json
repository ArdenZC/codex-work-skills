{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operator-controller-build-inventory 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_inventory_version",
    "controller_id",
    "controller_root",
    "python_runtime",
    "components"
  ],
  "properties": {
    "build_inventory_version": { "const": "1.1" },
    "controller_id": {
      "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"
    },
    "controller_root": { "type": "string", "minLength": 1 },
    "python_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_executable", "python_executable_sha256", "python_version", "site_packages_root", "site_packages_sha256"],
      "properties": {
        "python_executable": { "type": "string", "minLength": 1 },
        "python_executable_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "python_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "site_packages_root": { "type": "string", "minLength": 1 },
        "site_packages_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "component_type", "runtime_path", "sha256"],
        "properties": {
          "component_id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "component_type": {
            "enum": ["python_module", "json_schema", "python_package", "python_dependency_module", "controller_tree"]
          },
          "inventory_key": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
          "runtime_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "component_type": { "enum": ["python_module", "json_schema"] } } },
            "then": { "required": ["inventory_key"] }
          }
        ]
      }
    }
  }
}
