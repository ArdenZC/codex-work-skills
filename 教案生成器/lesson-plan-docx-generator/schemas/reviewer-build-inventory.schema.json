{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reviewer-build-inventory 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventory_key",
          "sha256"
        ],
        "properties": {
          "inventory_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    }
  }
}
