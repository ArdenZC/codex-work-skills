{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "managed-qualification-approver-response 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_version",
    "decision",
    "rationale",
    "reviewed_operation_refs",
    "checks"
  ],
  "properties": {
    "response_version": {
      "const": "1.0"
    },
    "decision": {
      "enum": [
        "APPROVED",
        "REJECTED"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "\\S"
    },
    "reviewed_operation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "passed",
          "supporting_operation_refs"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "operation_coverage",
              "artifact_binding",
              "service_identity_consistency",
              "truth_blindness",
              "separate_authority"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "supporting_operation_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
