{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operator-controller-build-inventory 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_inventory_version",
    "controller_id",
    "components"
  ],
  "properties": {
    "build_inventory_version": {
      "const": "1.0"
    },
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "component_type",
          "inventory_key",
          "sha256"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "component_type": {
            "enum": [
              "python_module",
              "json_schema"
            ]
          },
          "inventory_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
