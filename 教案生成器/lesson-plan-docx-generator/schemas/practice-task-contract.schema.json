{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/schemas/practice-task-contract-v1.json",
  "title": "Practice Task Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "course_name", "practice_hours", "granularity", "tasks"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "course_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "practice_hours": {
      "anyOf": [
        {"type": "number", "minimum": 0, "multipleOf": 1},
        {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.0+)?)$"}
      ]
    },
    "granularity": {"type": "string", "enum": ["per_lesson", "per_task", "per_project"]},
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "project_id", "title", "lesson_ids", "practice_hours", "scenario", "objectives", "required_inputs", "tools_or_materials", "steps", "deliverables", "acceptance_criteria", "safety_or_compliance"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 2, "maxLength": 180},
        "lesson_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"}},
        "practice_hours": {
          "anyOf": [
            {"type": "number", "exclusiveMinimum": 0, "multipleOf": 1},
            {"type": "string", "pattern": "^[1-9][0-9]*(?:\\.0+)?$"}
          ]
        },
        "scenario": {"type": "string", "minLength": 1, "maxLength": 800},
        "objectives": {"$ref": "#/$defs/textList"},
        "required_inputs": {"$ref": "#/$defs/textList"},
        "tools_or_materials": {"$ref": "#/$defs/textList"},
        "steps": {"$ref": "#/$defs/textList"},
        "deliverables": {"$ref": "#/$defs/textList"},
        "acceptance_criteria": {"$ref": "#/$defs/textList"},
        "safety_or_compliance": {"$ref": "#/$defs/textList"}
      }
    }
  }
}
