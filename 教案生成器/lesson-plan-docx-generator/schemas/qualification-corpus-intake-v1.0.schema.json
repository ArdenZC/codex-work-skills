{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qualification-corpus-intake 1.0 — present custody only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake_version",
    "intake_id",
    "operation_id",
    "controller_id",
    "operator_principal",
    "operator_authorization_reference",
    "operator_authorization_sha256",
    "authority_profile_sha256",
    "policy_epoch",
    "operator_identity_basis",
    "operator_unix_uid",
    "protected_repository_owner_unix_uid",
    "qualification_corpus",
    "blind_holdout_truth",
    "cases",
    "purpose",
    "historical_author_claim",
    "intake_is_historical_authoring_operation",
    "recorded_at",
    "controller_build_inventory_sha256"
  ],
  "properties": {
    "intake_version": {
      "const": "1.0"
    },
    "intake_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "operator_principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "operator_authorization_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "operator_authorization_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "operator_identity_basis": {
      "const": "dedicated_os_account_option_b"
    },
    "operator_unix_uid": {
      "type": "integer",
      "minimum": 1
    },
    "protected_repository_owner_unix_uid": {
      "type": "integer",
      "minimum": 1
    },
    "qualification_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_key",
        "sha256",
        "corpus_contract_version",
        "corpus_id",
        "corpus_version"
      ],
      "properties": {
        "inventory_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus_contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "\\S"
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "corpus_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        }
      }
    },
    "blind_holdout_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_key",
        "sha256",
        "corpus_contract_version",
        "corpus_id",
        "corpus_version"
      ],
      "properties": {
        "inventory_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus_contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "\\S"
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "corpus_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "cohort",
          "content",
          "authoring_id",
          "source_truth_manifest",
          "outline",
          "sources",
          "origin"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "cohort": {
            "enum": [
              "golden",
              "blind_holdout"
            ]
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inventory_key",
              "sha256"
            ],
            "properties": {
              "inventory_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "authoring_id": {
            "type": "string",
            "minLength": 6,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "source_truth_manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inventory_key",
              "sha256"
            ],
            "properties": {
              "inventory_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "outline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inventory_key",
              "sha256"
            ],
            "properties": {
              "inventory_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inventory_key",
                "sha256"
              ],
              "properties": {
                "inventory_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "origin": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "origin_metadata_only",
                  "git_commit",
                  "content_path"
                ],
                "properties": {
                  "origin_metadata_only": {
                    "const": true
                  },
                  "git_commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "content_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))\\S"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "purpose": {
      "const": "qualification_only"
    },
    "historical_author_claim": {
      "const": "not_made"
    },
    "intake_is_historical_authoring_operation": {
      "const": false
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "controller_build_inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
