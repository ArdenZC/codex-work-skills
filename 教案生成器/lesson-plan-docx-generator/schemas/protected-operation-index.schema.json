{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "protected-operation-index 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index_version",
    "controller_id",
    "policy_epoch",
    "receipts",
    "authors",
    "adjudications",
    "qualification_runs"
  ],
  "properties": {
    "index_version": {
      "const": "1.0"
    },
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "operation_id",
          "actor_principal",
          "subject_inventory_key",
          "subject_sha256",
          "receipt_inventory_key",
          "receipt_sha256"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "actor_principal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "subject_inventory_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "receipt_inventory_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authoring_id",
          "operation_id",
          "principal_id",
          "content_sha256"
        ],
        "properties": {
          "authoring_id": {
            "type": "string",
            "minLength": 6,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "principal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "actor_principal",
          "subject_inventory_key",
          "subject_sha256"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "actor_principal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "subject_inventory_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "qualification_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "review_operation_ids",
          "input_inventory_keys",
          "labels_hidden",
          "prior_reasoning_hidden",
          "fresh_context"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "review_operation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "input_inventory_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "labels_hidden": {
            "const": true
          },
          "prior_reasoning_hidden": {
            "const": true
          },
          "fresh_context": {
            "const": true
          }
        }
      },
      "minItems": 0
    }
  }
}
