{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/schemas/lesson-plan-input-v2.2.json",
  "title": "Lesson Content V2/V2.1/V2.2 input",
  "type": "object",
  "additionalProperties": false,
  "required": ["content_contract_version", "course_name", "major", "audience", "default_hours", "total_hours", "lessons"],
  "properties": {
    "content_contract_version": {"enum": ["2.0", "2.1", "2.2"]},
    "course_name": {"type": "string", "minLength": 1, "maxLength": 32},
    "major": {"type": "string", "minLength": 1, "maxLength": 32},
    "audience": {"type": "string", "minLength": 1, "maxLength": 32},
    "default_hours": {"$ref": "#/$defs/positiveNumber"},
    "total_hours": {"$ref": "#/$defs/positiveNumber"},
    "delivery_plan": {"$ref": "#/$defs/deliveryPlan"},
    "course_materials": {"$ref": "#/$defs/courseMaterials"},
    "reference_pool": {"type": "array", "items": {"$ref": "#/$defs/referencePoolItem"}},
    "allow_textbook_as_reference": {"type": "boolean"},
    "artifact_plan": {"$ref": "#/$defs/artifactPlan"},
    "practice_task_contract": {"$ref": "https://codex-work-skills.local/schemas/shared/practice-task-contract-v1.json"},
    "outline": {"type": "array", "items": {"$ref": "#/$defs/outlineItem"}},
    "lessons": {"type": "array"}
  },
  "allOf": [
    {
      "if": {"properties": {"content_contract_version": {"const": "2.0"}}, "required": ["content_contract_version"]},
      "then": {
        "properties": {
          "artifact_plan": {"$ref": "#/$defs/artifactPlanLegacy"},
          "lessons": {"minItems": 1, "items": {"$ref": "#/$defs/lesson"}}
        }
      }
    },
    {
      "if": {"properties": {"content_contract_version": {"const": "2.1"}}, "required": ["content_contract_version"]},
      "then": {
        "required": ["delivery_plan", "course_materials", "reference_pool", "artifact_plan", "outline"],
        "properties": {
          "artifact_plan": {"$ref": "#/$defs/artifactPlanLegacy"},
          "lessons": {"minItems": 1, "items": {"$ref": "#/$defs/lessonV21"}}
        }
      }
    },
    {
      "if": {"properties": {"content_contract_version": {"const": "2.2"}}, "required": ["content_contract_version"]},
      "then": {
        "required": ["delivery_plan", "course_materials", "reference_pool", "artifact_plan", "outline"],
        "properties": {
          "reference_pool": {"items": {"$ref": "#/$defs/referencePoolItemV22"}},
          "lessons": {"minItems": 0, "items": {"$ref": "#/$defs/lessonV22"}}
        }
      }
    }
  ],
  "$defs": {
    "positiveNumber": {
      "anyOf": [
        {"type": "number", "minimum": 1, "multipleOf": 1},
        {"type": "string", "pattern": "^[1-9][0-9]*(?:\\.0+)?$"}
      ]
    },
    "nonNegativeNumber": {
      "anyOf": [
        {"type": "number", "minimum": 0, "multipleOf": 1},
        {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.0+)?)$"}
      ]
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "twoOrMoreText": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 220}
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_lesson_id", "prior_learning", "capability_stage", "deliverable", "next_bridge"],
      "properties": {
        "prior_lesson_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32
        },
        "prior_learning": {"type": "string", "minLength": 6, "maxLength": 240},
        "capability_stage": {"type": "string", "enum": ["认知", "理解", "模仿", "独立", "综合", "优化", "迁移"]},
        "deliverable": {"type": "string", "minLength": 6, "maxLength": 240},
        "next_bridge": {"type": "string", "minLength": 6, "maxLength": 240}
      }
    },
    "studentAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "problems", "strategies"],
      "properties": {
        "base": {"$ref": "#/$defs/twoOrMoreText"},
        "problems": {"$ref": "#/$defs/twoOrMoreText"},
        "strategies": {"$ref": "#/$defs/twoOrMoreText"}
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "ability", "quality"],
      "properties": {
        "knowledge": {"$ref": "#/$defs/twoOrMoreText"},
        "ability": {"$ref": "#/$defs/twoOrMoreText"},
        "quality": {"$ref": "#/$defs/twoOrMoreText"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "strategy"],
      "properties": {"content": {"$ref": "#/$defs/textList"}, "strategy": {"$ref": "#/$defs/textList"}}
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_kind"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 180},
        "source_kind": {"type": "string", "enum": ["provided", "generic", "verified_public"]},
        "evidence": {"type": ["string", "null"], "maxLength": 500}
      },
      "allOf": [
        {
          "if": {"properties": {"source_kind": {"const": "provided"}}, "required": ["source_kind"]},
          "then": {
            "required": ["evidence"],
            "properties": {"evidence": {"type": "string", "minLength": 1}}
          }
        },
        {
          "if": {"properties": {"source_kind": {"const": "verified_public"}}, "required": ["source_kind"]},
          "then": {
            "required": ["evidence"],
            "properties": {"evidence": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "implementationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "minutes", "modality", "content", "teacher_actions", "student_actions", "objective"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "label": {"type": "string", "minLength": 1, "maxLength": 24},
        "minutes": {"type": "integer", "minimum": 0},
        "modality": {"type": "string", "minLength": 1, "maxLength": 32},
        "content": {"$ref": "#/$defs/textList"},
        "teacher_actions": {"$ref": "#/$defs/textList"},
        "student_actions": {"$ref": "#/$defs/textList"},
        "objective": {"type": "string", "minLength": 6, "maxLength": 220}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "remarks"],
      "properties": {
        "score": {"type": "number", "minimum": 85, "maximum": 96, "multipleOf": 0.5},
        "remarks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attendance", "attention", "participation", "compliance", "values", "ethics", "habits", "online_learning", "discussion", "homework", "practice", "presentation", "improvement"],
          "properties": {
            "attendance": {"type": "string", "minLength": 1, "maxLength": 80},
            "attention": {"type": "string", "minLength": 1, "maxLength": 80},
            "participation": {"type": "string", "minLength": 1, "maxLength": 80},
            "compliance": {"type": "string", "minLength": 1, "maxLength": 80},
            "values": {"type": "string", "minLength": 1, "maxLength": 80},
            "ethics": {"type": "string", "minLength": 1, "maxLength": 80},
            "habits": {"type": "string", "minLength": 1, "maxLength": 80},
            "online_learning": {"type": "string", "minLength": 1, "maxLength": 80},
            "discussion": {"type": "string", "minLength": 1, "maxLength": 80},
            "homework": {"type": "string", "minLength": 1, "maxLength": 80},
            "practice": {"type": "string", "minLength": 1, "maxLength": 80},
            "presentation": {"type": "string", "minLength": 1, "maxLength": 80},
            "improvement": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        }
      }
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "innovation", "improvement"],
      "properties": {
        "summary": {"type": "string", "minLength": 12, "maxLength": 360},
        "innovation": {"type": "string", "minLength": 12, "maxLength": 360},
        "improvement": {"type": "string", "minLength": 12, "maxLength": 360}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "unit", "task", "hours", "progression", "student_analysis", "teaching_content", "goals", "key_point", "difficult_point", "teaching_methods", "resources", "references", "implementation", "evaluation", "reflection"],
      "properties": {
        "lesson_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
        "unit": {"type": "string", "pattern": "^项目[^\\s]*.*", "minLength": 3, "maxLength": 60},
        "task": {"type": "string", "minLength": 2, "maxLength": 80},
        "hours": {"$ref": "#/$defs/positiveNumber"},
        "progression": {"$ref": "#/$defs/progression"},
        "student_analysis": {"$ref": "#/$defs/studentAnalysis"},
        "teaching_content": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
        "goals": {"$ref": "#/$defs/goals"},
        "key_point": {"$ref": "#/$defs/point"},
        "difficult_point": {"$ref": "#/$defs/point"},
        "teaching_methods": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "resources": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "references": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/reference"}},
        "implementation": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/implementationStage"}},
        "evaluation": {"$ref": "#/$defs/evaluation"},
        "reflection": {"$ref": "#/$defs/reflection"}
      }
    },
    "deliveryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "total_hours", "theory_hours", "practice_hours"],
      "properties": {
        "mode": {"type": "string", "enum": ["theory_only", "practice_only", "split_lessons", "integrated_lessons", "hybrid"]},
        "total_hours": {"$ref": "#/$defs/positiveNumber"},
        "theory_hours": {"$ref": "#/$defs/nonNegativeNumber"},
        "practice_hours": {"$ref": "#/$defs/nonNegativeNumber"}
      }
    },
    "citationAuthors": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "referencePoolItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "reference_type", "title", "source_kind"],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
        "reference_type": {"type": "string", "enum": ["book", "standard", "official_manual", "official_documentation", "guideline", "paper", "formal_course_document"]},
        "authors": {"$ref": "#/$defs/citationAuthors"},
        "title": {"type": "string", "minLength": 2, "maxLength": 240},
        "edition": {"type": "string", "minLength": 1, "maxLength": 80},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_kind": {"type": "string", "enum": ["provided", "generic", "verified_public"]},
        "source_region": {"type": "string", "enum": ["domestic", "foreign", "unknown"]},
        "evidence": {"type": ["string", "null"], "maxLength": 800}
      }
    },
    "referencePoolItemV22": {
      "allOf": [
        {"$ref": "#/$defs/referencePoolItem"},
        {
          "type": "object",
          "required": ["source_region"],
          "properties": {
            "source_region": {"type": "string", "enum": ["domestic", "foreign", "unknown"]}
          }
        }
      ]
    },
    "textbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source_kind"],
      "properties": {
        "authors": {"$ref": "#/$defs/citationAuthors"},
        "title": {"type": "string", "minLength": 2, "maxLength": 240},
        "edition": {"type": "string", "minLength": 1, "maxLength": 80},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_kind": {"type": "string", "enum": ["provided", "generic", "verified_public"]},
        "evidence": {"type": ["string", "null"], "maxLength": 800}
      }
    },
    "courseMaterials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textbook"],
      "properties": {"textbook": {"type": ["object", "null"], "oneOf": [{"$ref": "#/$defs/textbook"}, {"type": "null"}]}}
    },
    "artifactPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_plans", "practice_work_orders"],
      "properties": {
        "lesson_plans": {"type": "boolean"},
        "practice_work_orders": {"type": "boolean"}
      }
    },
    "artifactPlanLegacy": {
      "allOf": [
        {"$ref": "#/$defs/artifactPlan"},
        {
          "type": "object",
          "properties": {"lesson_plans": {"const": true}}
        }
      ]
    },
    "outlineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "unit", "task", "lesson_type", "hours", "theory_hours", "practice_hours", "prior_learning", "capability_stage", "deliverable", "next_bridge", "practice_task_ids"],
      "properties": {
        "lesson_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
        "unit": {"type": "string", "minLength": 3, "maxLength": 60},
        "task": {"type": "string", "minLength": 2, "maxLength": 80},
        "lesson_type": {"type": "string", "enum": ["theory", "practice", "integrated"]},
        "hours": {"$ref": "#/$defs/positiveNumber"},
        "theory_hours": {"$ref": "#/$defs/nonNegativeNumber"},
        "practice_hours": {"$ref": "#/$defs/nonNegativeNumber"},
        "prior_learning": {"type": "string", "minLength": 6, "maxLength": 240},
        "capability_stage": {"type": "string", "enum": ["认知", "理解", "模仿", "独立", "综合", "优化", "迁移"]},
        "deliverable": {"type": "string", "minLength": 6, "maxLength": 240},
        "next_bridge": {"type": "string", "minLength": 6, "maxLength": 240},
        "practice_task_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}}
      }
    },
    "lessonV21": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "unit", "task", "lesson_type", "hours", "theory_hours", "practice_hours", "progression", "student_analysis", "teaching_content", "goals", "key_point", "difficult_point", "teaching_methods", "resources", "reference_ids", "practice_task_ids", "implementation", "evaluation", "reflection"],
      "properties": {
        "lesson_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
        "unit": {"type": "string", "pattern": "^项目[^\\s]*.*", "minLength": 3, "maxLength": 60},
        "task": {"type": "string", "minLength": 2, "maxLength": 80},
        "lesson_type": {"type": "string", "enum": ["theory", "practice", "integrated"]},
        "hours": {"$ref": "#/$defs/positiveNumber"},
        "theory_hours": {"$ref": "#/$defs/nonNegativeNumber"},
        "practice_hours": {"$ref": "#/$defs/nonNegativeNumber"},
        "progression": {"$ref": "#/$defs/progression"},
        "student_analysis": {"$ref": "#/$defs/studentAnalysis"},
        "teaching_content": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
        "goals": {"$ref": "#/$defs/goals"},
        "key_point": {"$ref": "#/$defs/point"},
        "difficult_point": {"$ref": "#/$defs/point"},
        "teaching_methods": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "resources": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "reference_ids": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}},
        "practice_task_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}},
        "implementation": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/implementationStage"}},
        "evaluation": {"$ref": "#/$defs/evaluation"},
        "reflection": {"$ref": "#/$defs/reflection"}
      }
    },
    "lessonV22": {
      "allOf": [
        {"$ref": "#/$defs/lessonV21"},
        {
          "type": "object",
          "required": ["reference_ids"],
          "properties": {
            "reference_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}
            }
          }
        }
      ]
    }
  }
}
