{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/lesson-plan-input.schema.json",
  "title": "Projectized lesson plan input",
  "type": "object",
  "required": ["course_name", "lessons"],
  "properties": {
    "course_name": {"type": "string", "minLength": 1, "maxLength": 32},
    "major": {"type": "string", "minLength": 1, "maxLength": 32},
    "audience": {"type": "string", "minLength": 1, "maxLength": 32},
    "default_hours": {"type": ["string", "number"], "minLength": 1, "exclusiveMinimum": 0},
    "total_hours": {"type": ["string", "number"], "minimum": 0},
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit", "task", "hours"],
        "properties": {
          "course_name": {"type": "string", "minLength": 1, "maxLength": 32},
          "major": {"type": "string", "minLength": 1, "maxLength": 32},
          "audience": {"type": "string", "minLength": 1, "maxLength": 32},
          "unit": {"type": "string", "minLength": 1, "maxLength": 60},
          "task": {"type": "string", "minLength": 1, "maxLength": 80},
          "hours": {"type": ["string", "number"], "minLength": 1, "exclusiveMinimum": 0},
          "flows": {"type": "array", "items": {"type": "string", "maxLength": 200}},
          "knowledge": {"type": "array", "items": {"type": "string", "maxLength": 200}},
          "tools": {"type": "string", "maxLength": 300},
          "score": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 0.5}
        },
          "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
