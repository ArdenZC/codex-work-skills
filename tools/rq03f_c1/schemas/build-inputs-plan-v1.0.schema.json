{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RQ03F Controller Build Inventory candidate inputs 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "source_commit", "source_checkout", "target_platform",
    "operator_uid", "operator_gid",
    "controller_id", "inventory_key", "controller_root", "protected_trust_root", "scripts_root",
    "schemas_root", "generation_id", "generation_root", "allocation_plan_sha256",
    "allocation_record_path", "allocation_record_sha256", "runtime_root", "build_python_executable",
    "python_executable", "python_version",
    "site_packages_root", "requirements_lock", "requirements_lock_sha256", "wheelhouse_root",
    "wheelhouse_manifest", "wheelhouse_manifest_sha256", "inventory_output"
  ],
  "properties": {
    "schema_version": { "const": "rq03f-build-inputs-1.0" },
    "purpose": { "const": "candidate_inventory_only" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_checkout": { "type": "string", "minLength": 2, "pattern": "^/" },
    "target_platform": { "type": "string", "pattern": "^linux-[A-Za-z0-9_]+$" },
    "operator_uid": { "type": "integer", "minimum": 1 },
    "operator_gid": { "type": "integer", "minimum": 1 },
    "controller_id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "inventory_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]{0,159}$" },
    "generation_id": { "type": "string", "pattern": "^rq03f-[a-z0-9](?:[a-z0-9-]{0,54}[a-z0-9])?$" },
    "generation_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "allocation_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "allocation_record_path": { "type": "string", "minLength": 2, "pattern": "^/" },
    "allocation_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "controller_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "protected_trust_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "scripts_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "schemas_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "runtime_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "build_python_executable": { "type": "string", "minLength": 2, "pattern": "^/" },
    "python_executable": { "type": "string", "minLength": 2, "pattern": "^/" },
    "python_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "site_packages_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "requirements_lock": { "type": "string", "minLength": 2, "pattern": "^/" },
    "requirements_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wheelhouse_root": { "type": "string", "minLength": 2, "pattern": "^/" },
    "wheelhouse_manifest": { "type": "string", "minLength": 2, "pattern": "^/" },
    "wheelhouse_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inventory_output": { "type": "string", "minLength": 2, "pattern": "^/" }
  }
}
