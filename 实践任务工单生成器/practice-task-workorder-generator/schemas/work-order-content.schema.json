{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdenZC/codex-work-skills/practice-work-order-content-v1.schema.json",
  "title": "Practice Work Order Content V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_contract_version",
    "course_name",
    "major",
    "class_or_audience",
    "practice_task_id",
    "project_name",
    "practice_hours",
    "group",
    "task_items"
  ],
  "properties": {
    "content_contract_version": {
      "const": "1.0"
    },
    "course_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "major": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "class_or_audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "practice_task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "task_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "lesson_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "maxItems": 64,
      "uniqueItems": true
    },
    "granularity": {
      "type": "string",
      "enum": ["per_lesson", "per_task", "per_project"]
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "practice_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "leader_placeholder", "member_placeholder"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "leader_placeholder": {"type": "string", "minLength": 1, "maxLength": 80},
        "member_placeholder": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "task_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "score",
          "tools_or_materials",
          "steps",
          "deliverables",
          "acceptance_criteria"
        ],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": {"type": "string", "minLength": 1, "maxLength": 1600},
          "score": {"type": "integer", "minimum": 1, "maximum": 90},
          "tools_or_materials": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 120}
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          }
        }
      }
    },
    "safety_or_compliance": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "minItems": 1,
      "maxItems": 12
    },
    "teacher_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "maxLength": 240}
      }
    }
  }
}
