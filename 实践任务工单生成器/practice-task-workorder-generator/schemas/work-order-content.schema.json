{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdenZC/codex-work-skills/practice-work-order-content-v1.1.schema.json",
  "title": "Practice Work Order Content 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_contract_version",
    "mode",
    "course_profile",
    "task_id",
    "project_id",
    "task_title",
    "lesson_ids",
    "granularity",
    "practice_hours",
    "group",
    "task_items",
    "pedagogical_review"
  ],
  "properties": {
    "content_contract_version": {"const": "1.1"},
    "mode": {"type": "string", "enum": ["linked", "standalone"]},
    "course_profile": {"$ref": "#/$defs/courseProfile"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_title": {"type": "string", "minLength": 2, "maxLength": 180},
    "lesson_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"}
    },
    "granularity": {"type": "string", "const": "per_task"},
    "practice_hours": {"const": 2},
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "leader_placeholder", "member_placeholder"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "leader_placeholder": {"type": "string", "minLength": 1, "maxLength": 80},
        "member_placeholder": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "task_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/taskItem"}
    },
    "safety_or_compliance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "source_task_snapshot": {"$ref": "#/$defs/taskSnapshot"},
    "pedagogical_review": {"$ref": "#/$defs/pedagogicalReview"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "linked"}}, "required": ["mode"]},
      "then": {"required": ["source_task_snapshot"]}
    },
    {
      "if": {"properties": {"mode": {"const": "standalone"}}, "required": ["mode"]},
      "then": {"not": {"required": ["source_task_snapshot"]}}
    }
  ],
  "$defs": {
    "nonNegativeHours": {
      "anyOf": [
        {"type": "number", "minimum": 0, "multipleOf": 1},
        {"type": "string", "pattern": "^(?:0|[1-9][0-9]*(?:\\.0+)?)$"}
      ]
    },
    "positiveHours": {
      "anyOf": [
        {"type": "number", "exclusiveMinimum": 0, "multipleOf": 1},
        {"type": "string", "pattern": "^[1-9][0-9]*(?:\\.0+)?$"}
      ]
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "courseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_name",
        "major",
        "audience",
        "total_hours",
        "theory_hours",
        "practice_hours",
        "delivery_mode",
        "default_lesson_hours"
      ],
      "properties": {
        "course_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "major": {"type": "string", "minLength": 1, "maxLength": 64},
        "audience": {"type": "string", "minLength": 1, "maxLength": 64},
        "total_hours": {"$ref": "#/$defs/positiveHours"},
        "theory_hours": {"$ref": "#/$defs/nonNegativeHours"},
        "practice_hours": {"$ref": "#/$defs/nonNegativeHours"},
        "delivery_mode": {
          "type": "string",
          "enum": ["theory_only", "practice_only", "split_lessons", "integrated_lessons", "hybrid"]
        },
        "default_lesson_hours": {"$ref": "#/$defs/positiveHours"}
      }
    },
    "taskSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "project_id",
        "title",
        "lesson_ids",
        "practice_hours",
        "scenario",
        "objectives",
        "required_inputs",
        "steps",
        "deliverables",
        "acceptance_criteria",
        "tools_or_materials",
        "safety_or_compliance"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 2, "maxLength": 180},
        "lesson_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"}
        },
        "practice_hours": {"const": 2},
        "scenario": {"type": "string", "minLength": 1, "maxLength": 800},
        "objectives": {"$ref": "#/$defs/textList"},
        "required_inputs": {"$ref": "#/$defs/textList"},
        "steps": {"$ref": "#/$defs/textList"},
        "deliverables": {"$ref": "#/$defs/textList"},
        "acceptance_criteria": {"$ref": "#/$defs/textList"},
        "tools_or_materials": {"$ref": "#/$defs/textList"},
        "safety_or_compliance": {"$ref": "#/$defs/textList"}
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverable_id", "text"],
      "properties": {
        "deliverable_id": {"type": "string", "pattern": "^D[1-9][0-9]*$"},
        "text": {"type": "string", "minLength": 2, "maxLength": 300}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "text", "covers"],
      "properties": {
        "criterion_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
        "text": {"type": "string", "minLength": 2, "maxLength": 300},
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^D[1-9][0-9]*$"}
        }
      }
    },
    "taskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "score",
        "tools_or_materials",
        "steps",
        "deliverables",
        "acceptance_criteria"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 2, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 1600},
        "score": {"type": "integer", "minimum": 1, "maximum": 90},
        "tools_or_materials": {"$ref": "#/$defs/textList"},
        "steps": {"$ref": "#/$defs/textList"},
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/deliverable"}
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/criterion"}
        }
      }
    },
    "pedagogicalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "capacity", "summary", "checks"],
      "properties": {
        "status": {"type": "string", "enum": ["approved", "needs_revision"]},
        "capacity": {"type": "string", "enum": ["fit", "risk"]},
        "summary": {"type": "string", "minLength": 12, "maxLength": 800},
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["boolean", "string"]}
        }
      }
    }
  }
}
