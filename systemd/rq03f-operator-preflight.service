# C2 candidate unit only. It has no [Install] section and is not installable
# or enabled in this repository. Before any separately authorized deployment,
# its absolute Generation paths must be replaced with the exact Owner-adopted
# final paths and the resulting unit bytes must be reviewed and pinned.
[Unit]
Description=RQ-03F fixed Operator read-only preflight (candidate unit)
Documentation=man:systemd.service(5)
DefaultDependencies=yes

[Service]
Type=oneshot
User=rq03f-operator
Group=rq03f-operator
WorkingDirectory=/
Environment=PATH=/usr/bin:/bin
Environment=HOME=/var/empty
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONUSERBASE PYTHONSTARTUP PYTHONINSPECT USER LOGNAME SHELL XDG_RUNTIME_DIR INVOCATION_ID JOURNAL_STREAM SYSTEMD_EXEC_PID LISTEN_PID LISTEN_FDS LISTEN_FDNAMES NOTIFY_SOCKET WATCHDOG_PID WATCHDOG_USEC WATCHDOG_RUNTIME_USEC
ExecStart=/opt/rq03f/generations/rq03f-candidate-0001/runtime/bin/python -I -S -B /opt/rq03f/generations/rq03f-candidate-0001/controller/scripts/rq03f_fixed_operator_launcher.py
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
DevicePolicy=closed
ReadOnlyPaths=/etc/rq03f /opt/rq03f/generations/rq03f-candidate-0001
InaccessiblePaths=/home /root /run/user
TimeoutStartSec=30s
Restart=no
