{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdenZC/codex-work-skills/courseware-html-generator/courseware-content.schema.json",
  "title": "Courseware Content Contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "course_title", "chapter_title", "audience", "content_reserve_minutes", "slides"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "course_title": {"type": "string", "minLength": 1},
    "chapter_title": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "content_reserve_minutes": {"type": "integer", "minimum": 1},
    "theme": {"type": "string", "minLength": 1},
    "course_context": {"$ref": "#/$defs/courseContext"},
    "slides": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "stringList": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "courseContext": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "course_name": {"$ref": "#/$defs/nonEmpty"},
        "audience": {"$ref": "#/$defs/nonEmpty"},
        "language": {"$ref": "#/$defs/nonEmpty"},
        "tools": {"$ref": "#/$defs/stringList"},
        "platform": {"$ref": "#/$defs/nonEmpty"},
        "software": {"$ref": "#/$defs/nonEmpty"},
        "database_dialect": {"$ref": "#/$defs/nonEmpty"},
        "framework": {"$ref": "#/$defs/nonEmpty"},
        "other_constraints": {"$ref": "#/$defs/stringList"}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "layout", "blocks", "speaker_script", "suggested_minutes"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "title": {"$ref": "#/$defs/nonEmpty"},
        "kicker": {"type": "string"},
        "layout": {"enum": ["hero", "split", "grid", "focus", "comparison", "timeline", "default"]},
        "blocks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type"]}},
        "speaker_script": {"$ref": "#/$defs/nonEmpty"},
        "suggested_minutes": {"type": "integer", "minimum": 1},
        "demo_hint": {"type": "string"},
        "classroom_followup": {"type": "string"},
        "pacing_note": {"type": "string"}
      }
    }
  }
}
