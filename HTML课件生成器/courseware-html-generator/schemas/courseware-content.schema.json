{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdenZC/codex-work-skills/courseware-html-generator/courseware-content.schema.json",
  "title": "Courseware Content Contract 1.1",
  "description": "Stable theory source contract. Legacy 1.0 is migrated by scripts/content_contract.py before rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "course_title", "chapter_title", "audience", "session_minutes", "prepared_minutes", "core_minutes", "extension_minutes", "learning_units", "canonical_facts", "slides"],
  "properties": {
    "contract_version": {"const": "1.1"},
    "course_title": {"$ref": "#/$defs/nonEmpty"},
    "chapter_title": {"$ref": "#/$defs/nonEmpty"},
    "audience": {"$ref": "#/$defs/nonEmpty"},
    "session_minutes": {"type": "integer", "minimum": 1},
    "prepared_minutes": {"type": "integer", "minimum": 1},
    "core_minutes": {"type": "integer", "minimum": 0},
    "extension_minutes": {"type": "integer", "minimum": 0},
    "theme": {"$ref": "#/$defs/nonEmpty"},
    "course_context": {"$ref": "#/$defs/courseContext"},
    "learning_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learningUnit"}},
    "canonical_facts": {"type": "array", "items": {"$ref": "#/$defs/canonicalFact"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/imageAsset"}},
    "slides": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/slide"}}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "stringList": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}},
    "requiredStringList": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "courseContext": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "course_name": {"$ref": "#/$defs/nonEmpty"}, "audience": {"$ref": "#/$defs/nonEmpty"},
        "language": {"$ref": "#/$defs/nonEmpty"}, "tools": {"$ref": "#/$defs/requiredStringList"},
        "platform": {"$ref": "#/$defs/nonEmpty"}, "software": {"$ref": "#/$defs/nonEmpty"},
        "database_dialect": {"$ref": "#/$defs/nonEmpty"}, "framework": {"$ref": "#/$defs/nonEmpty"},
        "other_constraints": {"$ref": "#/$defs/requiredStringList"}
      }
    },
    "learningUnit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "students_should_know", "students_should_be_able_to", "prerequisites", "not_yet_taught", "canonical_fact_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"},
        "students_should_know": {"$ref": "#/$defs/requiredStringList"},
        "students_should_be_able_to": {"$ref": "#/$defs/requiredStringList"},
        "prerequisites": {"$ref": "#/$defs/stringList"}, "not_yet_taught": {"$ref": "#/$defs/stringList"},
        "canonical_fact_ids": {"$ref": "#/$defs/stringList"}
      }
    },
    "canonicalFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "statement", "source_slide_ids", "learning_unit_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "kind": {"$ref": "#/$defs/nonEmpty"},
        "statement": {"$ref": "#/$defs/nonEmpty"}, "source_slide_ids": {"$ref": "#/$defs/stringList"},
        "learning_unit_ids": {"$ref": "#/$defs/stringList"}
      }
    },
    "imageAsset": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "path"],
      "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "kind": {"const": "image"}, "path": {"$ref": "#/$defs/nonEmpty"}}
    },
    "teachingIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["opening", "core_explanation", "example", "misconception", "question", "transition"],
      "properties": {
        "opening": {"$ref": "#/$defs/nonEmpty"}, "core_explanation": {"$ref": "#/$defs/nonEmpty"},
        "example": {"$ref": "#/$defs/nonEmpty"}, "misconception": {"$ref": "#/$defs/nonEmpty"},
        "question": {"$ref": "#/$defs/nonEmpty"}, "transition": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "slide": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "layout", "blocks", "speaker_script", "lecture_minutes", "activity_minutes", "suggested_minutes", "teaching_intent", "learning_unit_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "kicker": {"type": "string"},
        "layout": {"enum": ["hero", "split", "grid", "focus", "comparison", "timeline", "default"]},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
        "speaker_script": {"$ref": "#/$defs/nonEmpty"}, "lecture_minutes": {"type": "integer", "minimum": 0},
        "activity_minutes": {"type": "integer", "minimum": 0}, "suggested_minutes": {"type": "integer", "minimum": 1},
        "teaching_intent": {"$ref": "#/$defs/teachingIntent"}, "learning_unit_ids": {"$ref": "#/$defs/requiredStringList"},
        "demo_hint": {"type": "string"}, "classroom_followup": {"type": "string"}, "pacing_note": {"type": "string"}
      }
    },
    "block": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": {"enum": ["paragraph", "bullets", "cards", "table", "code", "formula", "svg", "image", "quiz", "stepper", "comparison", "summary"]},
        "asset_id": {"$ref": "#/$defs/nonEmpty"}, "caption": {"type": "string"}
      }
    }
  }
}
