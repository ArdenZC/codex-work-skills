{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdenZC/codex-work-skills/practice-class-html-generator/practice-class-content.schema.json",
  "title": "Practice Class Content Contract 1.1",
  "description": "Practice contract 1.1 consumes Courseware Content Contract 1.1. Legacy 1.0 is migrated by scripts/practice_contract.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "course_title",
    "practice_title",
    "audience",
    "duration_minutes",
    "source_courseware",
    "knowledge_links",
    "tasks",
    "learning_center",
    "study_guide",
    "foundation_kit",
    "teacher_guide",
    "teacher_reference",
    "starter_assets"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "course_title": {
      "type": "string",
      "minLength": 1
    },
    "practice_title": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 30
    },
    "course_context": {
      "$ref": "#/$defs/courseContext"
    },
    "source_courseware": {
      "$ref": "#/$defs/source"
    },
    "knowledge_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/knowledge"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "learning_center": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/center"
      }
    },
    "study_guide": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "foundation_kit": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/kit"
      }
    },
    "teacher_guide": {
      "$ref": "#/$defs/teacher"
    },
    "teacher_reference": {
      "$ref": "#/$defs/teacherReference"
    },
    "starter_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/starter"
      }
    },
    "integrity_version": {
      "const": "1.0"
    },
    "formula_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "formula",
          "example_scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "example_scope": {
            "enum": [
              "abstract",
              "current-dataset"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "semantic_intent": {
            "type": "string"
          },
          "bindings": {
            "type": "object"
          },
          "operation_location": {
            "type": "string"
          },
          "expected_result": {},
          "task_id": {
            "type": "string"
          }
        }
      }
    },
    "starter_bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "artifact_kind",
          "root",
          "files",
          "entrypoint"
        ],
        "properties": {
          "artifact_kind": {
            "const": "project"
          },
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "entrypoint": {
            "type": "string"
          },
          "framework": {
            "type": "string"
          },
          "template_path": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "role"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "student-edit",
                    "student-input",
                    "runtime-required",
                    "generated-scaffold",
                    "teacher-reference",
                    "test-only"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "classroom_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_path",
          "classification",
          "sha256",
          "title",
          "task_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "student_path": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "source-only-reference",
              "teacher-only-material",
              "student-classroom-input",
              "generated-starter-seed"
            ]
          }
        }
      }
    },
    "runtime_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ]
      }
    },
    "paper_work_authorization": {
      "type": "string"
    },
    "spreadsheet_workflow": {
      "type": "string"
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "strings0": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "courseContext": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "course_name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "audience": {
          "$ref": "#/$defs/nonEmpty"
        },
        "language": {
          "$ref": "#/$defs/nonEmpty"
        },
        "tools": {
          "$ref": "#/$defs/strings"
        },
        "platform": {
          "$ref": "#/$defs/nonEmpty"
        },
        "software": {
          "$ref": "#/$defs/nonEmpty"
        },
        "database_dialect": {
          "$ref": "#/$defs/nonEmpty"
        },
        "framework": {
          "$ref": "#/$defs/nonEmpty"
        },
        "other_constraints": {
          "$ref": "#/$defs/strings"
        },
        "delivery_environment": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "contract_version",
        "chapter_title",
        "taught_slide_ids"
      ],
      "properties": {
        "mode": {
          "enum": [
            "courseware",
            "independent"
          ]
        },
        "contract_version": {
          "const": "1.1"
        },
        "chapter_title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "taught_slide_ids": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "source_slide_ids",
        "student_can_do",
        "learning_unit_ids",
        "canonical_fact_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "summary": {
          "$ref": "#/$defs/nonEmpty"
        },
        "source_slide_ids": {
          "$ref": "#/$defs/strings"
        },
        "student_can_do": {
          "$ref": "#/$defs/nonEmpty"
        },
        "learning_unit_ids": {
          "$ref": "#/$defs/strings"
        },
        "canonical_fact_ids": {
          "$ref": "#/$defs/strings0"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "instruction"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "instruction": {
          "$ref": "#/$defs/nonEmpty"
        },
        "check": {
          "type": "string"
        }
      }
    },
    "timeBreakdownStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "minutes"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/nonEmpty"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "title",
        "knowledge_link_ids",
        "source_slide_ids",
        "learning_unit_ids",
        "canonical_fact_ids",
        "task_kind",
        "artifact_kind",
        "capabilities",
        "scaffold_level",
        "overview",
        "steps",
        "acceptance",
        "help_refs",
        "estimated_minutes",
        "scaffold"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "level": {
          "enum": [
            "core",
            "optional",
            "challenge"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "knowledge_link_ids": {
          "$ref": "#/$defs/strings"
        },
        "source_slide_ids": {
          "$ref": "#/$defs/strings"
        },
        "learning_unit_ids": {
          "$ref": "#/$defs/strings"
        },
        "canonical_fact_ids": {
          "$ref": "#/$defs/strings0"
        },
        "task_kind": {
          "enum": [
            "observation",
            "analysis",
            "implementation",
            "debugging",
            "modeling",
            "tooling",
            "experiment",
            "scenario",
            "mixed"
          ]
        },
        "artifact_kind": {
          "enum": [
            "source-code",
            "query",
            "model",
            "document",
            "workbook",
            "diagram",
            "scenario",
            "result",
            "mixed",
            "project"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "code_editing",
              "file_editing",
              "model_editing",
              "execution",
              "query_execution",
              "diagnosis",
              "state_tracking",
              "visualization",
              "explanation",
              "comparison",
              "scenario_reasoning",
              "tool_operation",
              "experiment"
            ]
          }
        },
        "scaffold_level": {
          "$ref": "#/$defs/nonEmpty"
        },
        "modality": {
          "$ref": "#/$defs/nonEmpty"
        },
        "overview": {
          "$ref": "#/$defs/nonEmpty"
        },
        "scaffold": {
          "$ref": "#/$defs/nonEmpty"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "acceptance": {
          "$ref": "#/$defs/strings"
        },
        "help_refs": {
          "$ref": "#/$defs/strings"
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 5
        },
        "time_breakdown": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/timeBreakdownStep"
          }
        },
        "starter_asset_ids": {
          "$ref": "#/$defs/strings"
        },
        "starter_bundle_ids": {
          "$ref": "#/$defs/strings"
        },
        "todo_count": {
          "type": "integer",
          "minimum": 0
        },
        "edit_targets": {
          "$ref": "#/$defs/strings"
        },
        "symptom": {
          "$ref": "#/$defs/nonEmpty"
        },
        "faulty_artifact": {
          "$ref": "#/$defs/nonEmpty"
        },
        "expected_behavior": {
          "$ref": "#/$defs/nonEmpty"
        },
        "diagnosis_target": {
          "$ref": "#/$defs/nonEmpty"
        },
        "repair_target": {
          "$ref": "#/$defs/nonEmpty"
        },
        "editable_model": {
          "$ref": "#/$defs/nonEmpty"
        },
        "required_edit": {
          "$ref": "#/$defs/nonEmpty"
        },
        "modeling_constraints": {
          "$ref": "#/$defs/strings"
        },
        "tool": {
          "$ref": "#/$defs/nonEmpty"
        },
        "starting_state": {
          "$ref": "#/$defs/nonEmpty"
        },
        "operations": {
          "$ref": "#/$defs/strings"
        },
        "expected_observable_result": {
          "$ref": "#/$defs/nonEmpty"
        },
        "variable": {
          "$ref": "#/$defs/nonEmpty"
        },
        "control": {
          "$ref": "#/$defs/nonEmpty"
        },
        "operation": {
          "$ref": "#/$defs/strings"
        },
        "observation": {
          "$ref": "#/$defs/strings"
        },
        "expected_reasoning": {
          "$ref": "#/$defs/nonEmpty"
        },
        "reference_verification": {
          "type": "object",
          "required": [
            "kind",
            "checks"
          ],
          "properties": {
            "kind": {
              "enum": [
                "behavioral",
                "manual"
              ]
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "verification_type"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "verification_type": {
                    "enum": [
                      "syntax",
                      "command",
                      "function-call",
                      "web-request",
                      "file-output",
                      "query-result",
                      "structured-data",
                      "browser",
                      "manual-evidence"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "task_kind": {
                "const": "implementation"
              }
            },
            "required": [
              "task_kind"
            ]
          },
          "then": {
            "required": [
              "starter_asset_ids",
              "edit_targets"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "code_editing"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          "then": {
            "required": [
              "starter_asset_ids",
              "edit_targets"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "task_kind": {
                "const": "debugging"
              }
            },
            "required": [
              "task_kind"
            ]
          },
          "then": {
            "required": [
              "symptom",
              "faulty_artifact",
              "expected_behavior",
              "diagnosis_target",
              "repair_target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "diagnosis"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          "then": {
            "required": [
              "symptom",
              "faulty_artifact",
              "expected_behavior",
              "diagnosis_target",
              "repair_target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "task_kind": {
                "const": "modeling"
              }
            },
            "required": [
              "task_kind"
            ]
          },
          "then": {
            "required": [
              "editable_model",
              "required_edit",
              "modeling_constraints"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "model_editing"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          "then": {
            "required": [
              "editable_model",
              "required_edit",
              "modeling_constraints"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "task_kind": {
                "const": "tooling"
              }
            },
            "required": [
              "task_kind"
            ]
          },
          "then": {
            "required": [
              "tool",
              "starting_state",
              "operations",
              "expected_observable_result"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "tool_operation"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          "then": {
            "required": [
              "tool",
              "starting_state",
              "operations",
              "expected_observable_result"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "task_kind": {
                "const": "experiment"
              }
            },
            "required": [
              "task_kind"
            ]
          },
          "then": {
            "required": [
              "variable",
              "control",
              "operation",
              "observation",
              "expected_reasoning"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "experiment"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          "then": {
            "required": [
              "variable",
              "control",
              "operation",
              "observation",
              "expected_reasoning"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "artifact_kind": {
                "const": "project"
              }
            },
            "required": [
              "artifact_kind"
            ]
          },
          "then": {
            "required": [
              "starter_bundle_ids"
            ]
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "feedback"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "feedback": {
          "$ref": "#/$defs/nonEmpty"
        },
        "correct": {
          "type": "boolean"
        }
      }
    },
    "stepperStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "text": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "prompt"
      ],
      "properties": {
        "type": {
          "enum": [
            "choice",
            "match",
            "stepper",
            "trace",
            "classify",
            "reorder",
            "diagnose",
            "predict-next",
            "build-relation",
            "state-simulator",
            "compare-strategies",
            "multi-question",
            "scenario-decision"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/nonEmpty"
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "success_feedback": {
          "$ref": "#/$defs/nonEmpty"
        },
        "retry_feedback": {
          "$ref": "#/$defs/nonEmpty"
        },
        "completion_feedback": {
          "$ref": "#/$defs/nonEmpty"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer_index": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/stepperStep"
          }
        },
        "categories": {
          "$ref": "#/$defs/strings"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/interactionItem"
          }
        },
        "correct_order": {
          "$ref": "#/$defs/strings"
        },
        "state_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stateField"
          }
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "visualization": {
          "$ref": "#/$defs/visualization"
        },
        "state_visual": {
          "$ref": "#/$defs/stateVisual"
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/round"
          }
        },
        "questions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "diagnostic_cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/diagnosticCase"
          }
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "interactionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "answer": {
          "$ref": "#/$defs/nonEmpty"
        },
        "feedback": {
          "$ref": "#/$defs/nonEmpty"
        },
        "hint": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "stateField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "input_type": {
          "enum": [
            "text",
            "number"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "context": {
          "$ref": "#/$defs/nonEmpty"
        },
        "target_label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "target": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "stateVisualItem": {
      "type": "object",
      "additionalProperties": false,
