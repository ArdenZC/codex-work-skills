{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArdenZC/codex-work-skills/practice-class-html-generator/practice-class-content.schema.json",
  "title": "Practice Class Content Contract 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "course_title", "practice_title", "audience", "duration_minutes", "source_courseware", "knowledge_links", "tasks", "learning_center", "study_guide", "foundation_kit", "teacher_guide", "teacher_reference", "starter_assets"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "course_title": {"type": "string", "minLength": 1},
    "practice_title": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "duration_minutes": {"type": "integer", "minimum": 30},
    "course_context": {"$ref": "#/$defs/courseContext"},
    "source_courseware": {"$ref": "#/$defs/source"},
    "knowledge_links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knowledge"}},
    "tasks": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/task"}},
    "learning_center": {"type": "array", "minItems": 5, "maxItems": 8, "items": {"$ref": "#/$defs/center"}},
    "study_guide": {"type": "array", "minItems": 6, "maxItems": 10, "items": {"$ref": "#/$defs/guide"}},
    "foundation_kit": {"type": "array", "minItems": 5, "maxItems": 10, "items": {"$ref": "#/$defs/kit"}},
    "teacher_guide": {"$ref": "#/$defs/teacher"},
    "teacher_reference": {"$ref": "#/$defs/teacherReference"},
    "starter_assets": {"type": "array", "items": {"$ref": "#/$defs/starter"}}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "courseContext": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "course_name": {"$ref": "#/$defs/nonEmpty"},
        "audience": {"$ref": "#/$defs/nonEmpty"},
        "language": {"$ref": "#/$defs/nonEmpty"},
        "tools": {"$ref": "#/$defs/strings"},
        "platform": {"$ref": "#/$defs/nonEmpty"},
        "software": {"$ref": "#/$defs/nonEmpty"},
        "database_dialect": {"$ref": "#/$defs/nonEmpty"},
        "framework": {"$ref": "#/$defs/nonEmpty"},
        "other_constraints": {"$ref": "#/$defs/strings"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "contract_version", "chapter_title", "taught_slide_ids"],
      "properties": {
        "mode": {"enum": ["courseware", "independent"]},
        "contract_version": {"const": "1.0"},
        "chapter_title": {"$ref": "#/$defs/nonEmpty"},
        "taught_slide_ids": {"$ref": "#/$defs/strings"}
      }
    },
    "knowledge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "source_slide_ids", "student_can_do"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"},
        "summary": {"$ref": "#/$defs/nonEmpty"}, "source_slide_ids": {"$ref": "#/$defs/strings"},
        "student_can_do": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "instruction"],
      "properties": {"title": {"$ref": "#/$defs/nonEmpty"}, "instruction": {"$ref": "#/$defs/nonEmpty"}, "check": {"type": "string"}}
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "level", "title", "knowledge_link_ids", "source_slide_ids", "modality", "overview", "steps", "acceptance", "help_refs", "estimated_minutes", "scaffold"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "level": {"enum": ["core", "optional", "challenge"]},
        "title": {"$ref": "#/$defs/nonEmpty"}, "knowledge_link_ids": {"$ref": "#/$defs/strings"}, "source_slide_ids": {"$ref": "#/$defs/strings"},
        "modality": {"$ref": "#/$defs/nonEmpty"}, "overview": {"$ref": "#/$defs/nonEmpty"},
        "scaffold": {"$ref": "#/$defs/nonEmpty"}, "steps": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/step"}},
        "acceptance": {"$ref": "#/$defs/strings"}, "help_refs": {"$ref": "#/$defs/strings"},
        "estimated_minutes": {"type": "integer", "minimum": 5}, "starter_asset_ids": {"$ref": "#/$defs/strings"}, "todo_count": {"type": "integer", "minimum": 0}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "feedback"],
      "properties": {"label": {"$ref": "#/$defs/nonEmpty"}, "feedback": {"$ref": "#/$defs/nonEmpty"}, "correct": {"type": "boolean"}}
    },
    "stepperStep": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {"title": {"$ref": "#/$defs/nonEmpty"}, "text": {"$ref": "#/$defs/nonEmpty"}}
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "prompt"],
      "properties": {
        "type": {"enum": ["choice", "match", "stepper", "trace", "classify", "reorder", "diagnose", "predict-next", "build-relation", "state-simulator", "compare-strategies", "multi-question", "scenario-decision"]},
        "prompt": {"$ref": "#/$defs/nonEmpty"},
        "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/option"}},
        "answer_index": {"type": "integer", "minimum": 0},
        "steps": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/stepperStep"}},
        "categories": {"$ref": "#/$defs/strings"},
        "items": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/interactionItem"}},
        "correct_order": {"$ref": "#/$defs/strings"},
        "state": {"$ref": "#/$defs/state"},
        "rounds": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/round"}},
        "questions": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/question"}}
      }
    },
    "interactionItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "label": {"$ref": "#/$defs/nonEmpty"}, "answer": {"$ref": "#/$defs/nonEmpty"}, "feedback": {"$ref": "#/$defs/nonEmpty"}}
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["values", "target"],
      "properties": {"values": {"type": "array", "minItems": 2}, "target": {"type": ["string", "number"]}}
    },
    "round": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right", "mid", "next_left", "next_right", "feedback"],
      "properties": {"left": {"type": "integer"}, "right": {"type": "integer"}, "mid": {"type": "integer"}, "next_left": {"type": "integer"}, "next_right": {"type": "integer"}, "feedback": {"$ref": "#/$defs/nonEmpty"}}
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "options", "answer_index"],
      "properties": {"prompt": {"$ref": "#/$defs/nonEmpty"}, "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/option"}}, "answer_index": {"type": "integer", "minimum": 0}}
    },
    "center": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "knowledge_link_ids", "task_ids", "purpose", "interaction"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"},
        "knowledge_link_ids": {"$ref": "#/$defs/strings"}, "task_ids": {"$ref": "#/$defs/strings"},
        "purpose": {"$ref": "#/$defs/nonEmpty"}, "interaction": {"$ref": "#/$defs/interaction"}
      }
    },
    "guide": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "knowledge_link_ids", "task_ids", "body", "worked_example", "quick_reference", "common_errors", "checkpoints"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"},
        "knowledge_link_ids": {"$ref": "#/$defs/strings"}, "task_ids": {"$ref": "#/$defs/strings"},
        "body": {"$ref": "#/$defs/nonEmpty"}, "worked_example": {"$ref": "#/$defs/nonEmpty"},
        "quick_reference": {"$ref": "#/$defs/strings"}, "common_errors": {"$ref": "#/$defs/strings"},
        "checkpoints": {"$ref": "#/$defs/strings"}
      }
    },
    "kit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "kind", "content", "task_ids", "when_to_use", "steps", "self_check"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "kind": {"$ref": "#/$defs/nonEmpty"},
        "content": {"$ref": "#/$defs/nonEmpty"}, "task_ids": {"$ref": "#/$defs/strings"},
        "when_to_use": {"$ref": "#/$defs/nonEmpty"}, "steps": {"$ref": "#/$defs/strings"}, "self_check": {"$ref": "#/$defs/strings"}
      }
    },
    "teacher": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "theory_bridge", "timing", "task_guidance", "common_errors", "pace_adjustments", "closing_checks"],
      "properties": {
        "purpose": {"$ref": "#/$defs/nonEmpty"}, "theory_bridge": {"$ref": "#/$defs/nonEmpty"},
        "timing": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["minutes", "focus"], "properties": {"minutes": {"type": "integer", "minimum": 1}, "focus": {"$ref": "#/$defs/nonEmpty"}}}},
        "task_guidance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "look_for", "ask_when_stuck"], "properties": {"task_id": {"$ref": "#/$defs/nonEmpty"}, "look_for": {"$ref": "#/$defs/nonEmpty"}, "ask_when_stuck": {"$ref": "#/$defs/nonEmpty"}}}},
        "common_errors": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["symptom", "intervention"], "properties": {"symptom": {"$ref": "#/$defs/nonEmpty"}, "intervention": {"$ref": "#/$defs/nonEmpty"}}}},
        "pace_adjustments": {"$ref": "#/$defs/strings"}, "closing_checks": {"$ref": "#/$defs/strings"}
      }
    },
    "teacherTaskReference": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "title", "source_slide_ids", "reference_answer", "key_steps", "acceptable_variants", "common_errors", "acceptance_basis"],
      "properties": {
        "task_id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "source_slide_ids": {"$ref": "#/$defs/strings"},
        "reference_answer": {"$ref": "#/$defs/nonEmpty"}, "reference_result": {"$ref": "#/$defs/nonEmpty"},
        "key_steps": {"$ref": "#/$defs/strings"}, "acceptable_variants": {"$ref": "#/$defs/strings"},
        "common_errors": {"$ref": "#/$defs/strings"}, "acceptance_basis": {"$ref": "#/$defs/strings"}
      }
    },
    "teacherReference": {
      "type": "object", "additionalProperties": false, "required": ["task_references"],
      "properties": {"task_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/teacherTaskReference"}}}
    },
    "starter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "language", "task_id", "content"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "path": {"$ref": "#/$defs/nonEmpty"}, "language": {"$ref": "#/$defs/nonEmpty"},
        "task_id": {"$ref": "#/$defs/nonEmpty"}, "content": {"type": "string"},
        "editable_gaps": {"type": "array", "items": {"$ref": "#/$defs/editableGap"}}
      }
    },
    "editableGap": {
      "type": "object", "additionalProperties": false,
      "required": ["marker", "replacement", "instruction", "kind"],
      "properties": {
        "marker": {"$ref": "#/$defs/nonEmpty"}, "replacement": {"$ref": "#/$defs/nonEmpty"},
        "instruction": {"$ref": "#/$defs/nonEmpty"}, "kind": {"$ref": "#/$defs/nonEmpty"}
      }
    }
  }
}
