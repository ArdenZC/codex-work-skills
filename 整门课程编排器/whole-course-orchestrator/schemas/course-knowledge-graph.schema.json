{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/whole-course/course-knowledge-graph.schema.json",
  "title": "Course Knowledge Graph",
  "type": "object",
  "required": ["schema_version", "graph_type", "nodes", "sessions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "graph_type": {"const": "course_knowledge_graph"},
    "course_id": {"type": "string"},
    "course_name": {"type": "string"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "title", "type", "source_assets", "prerequisites", "depends_on", "related_to", "first_taught_session", "revisited_sessions", "practice_dependencies"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "type": {"enum": ["concept", "notation", "procedure", "tool_skill", "analysis_skill", "modeling_skill", "calculation", "implementation", "diagnosis"]},
        "source_assets": {"type": "array", "items": {"type": "string"}},
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "related_to": {"type": "array", "items": {"type": "string"}},
        "first_taught_session": {"type": ["string", "null"]},
        "revisited_sessions": {"type": "array", "items": {"type": "string"}},
        "practice_dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "required": ["id", "title", "new_knowledge", "review_knowledge", "knowledge_state_before", "knowledge_state_after", "future_knowledge"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "new_knowledge": {"type": "array", "items": {"type": "string"}},
        "review_knowledge": {"type": "array", "items": {"type": "string"}},
        "knowledge_state_before": {"type": "array", "items": {"type": "string"}},
        "knowledge_state_after": {"type": "array", "items": {"type": "string"}},
        "future_knowledge": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
