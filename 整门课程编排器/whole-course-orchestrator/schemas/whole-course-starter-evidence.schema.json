{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/whole-course/whole-course-starter-evidence.schema.json",
  "title": "Whole-Course Practice Starter Evidence",
  "type": "object",
  "required": ["schema_version", "report_type", "status"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "report_type": {"const": "whole_course_starter_evidence"},
    "status": {"enum": ["PASS", "FAIL", "NOT_OBSERVED", "NOT_RUN"]},
    "sessions": {"type": "array", "items": {"type": "object"}},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "starter_observed": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
