{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/whole-course/whole-course-qa.schema.json",
  "title": "Whole-Course QA Reports",
  "type": "object",
  "required": ["schema_version", "report_type", "status", "architecture_status", "metrics", "findings"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "report_type": {"enum": ["whole_course_batch_qa", "whole_course_plan_qa", "whole_course_render_qa", "whole_course_failure_benchmark_replay"]},
    "status": {"enum": ["PASS", "FAIL", "NOT_EVALUATED", "BLOCKED"]},
    "architecture_status": {"enum": ["READY_FOR_WHOLE_COURSE_ARCHITECTURE_REVIEW", "WHOLE_COURSE_ARCHITECTURE_BLOCKED"]},
    "metrics": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
