{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/whole-course/session-plan.schema.json",
  "title": "Content Native Session Plan",
  "type": "object",
  "required": ["schema_version", "plan_type", "sessions"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "plan_type": {"const": "content_native_session_plans"},
    "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}}
  },
  "$defs": {
    "session": {
      "type": "object",
      "required": ["id", "teaching_questions", "pages", "knowledge_state_before", "knowledge_state_after"],
      "properties": {
        "id": {"type": "string"},
        "planning_mode": {"enum": ["draft", "release"]},
        "timing_status": {"enum": ["EVIDENCE_BACKED", "DEGRADED_ESTIMATE"]},
        "teaching_questions": {"type": "array", "minItems": 1},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
        "knowledge_state_before": {"type": "array"},
        "knowledge_state_after": {"type": "array"}
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["id", "teaching_question_id", "primary_job", "layout", "lecture_minutes", "activity_minutes", "suggested_minutes", "script_anchor_ids"],
      "properties": {
        "id": {"type": "string"},
        "teaching_question_id": {"type": "string"},
        "primary_job": {"type": "string"},
        "layout": {"type": "string"},
        "lecture_minutes": {"type": "number", "minimum": 0},
        "activity_minutes": {"type": "number", "minimum": 0},
        "suggested_minutes": {"type": "number", "minimum": 0},
        "delivery_mix": {"type": "object"},
        "timing_evidence": {"type": "object"},
        "layout_family": {"type": "array", "items": {"type": "string"}},
        "layout_rationale": {"type": "string"},
        "script_anchor_ids": {"type": "array", "minItems": 1}
      },
      "additionalProperties": true
    }
  }
}
