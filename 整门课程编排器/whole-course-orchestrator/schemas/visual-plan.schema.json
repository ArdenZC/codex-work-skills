{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/whole-course/visual-plan.schema.json",
  "title": "Semantic Visual Plan",
  "type": "object",
  "required": ["schema_version", "plan_type", "visual_plans"],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {
        "properties": {
          "visual_plans": {
            "items": {"required": ["planned_semantic_elements", "observed_semantic_elements"]}
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "plan_type": {"const": "semantic_visual_plans"},
    "visual_plans": {"type": "array", "items": {"$ref": "#/$defs/visual"}}
  },
  "$defs": {
    "visual": {
      "type": "object",
      "required": ["page_id", "visual_intent", "render_strategy"],
      "properties": {
        "page_id": {"type": "string"},
        "artifact_type": {"type": ["string", "null"]},
        "visual_intent": {"type": "string"},
        "semantic_elements": {"type": "array", "items": {"type": "string"}},
        "required_semantic_elements": {"type": "array", "items": {"type": "string"}},
        "planned_semantic_elements": {"type": "array", "items": {"type": "string"}},
        "observed_semantic_elements": {"type": "array", "items": {"type": "string"}},
        "structure_requirements": {"type": "object"},
        "semantic_structure_fixture": {"type": "boolean"},
        "semantic_marker_evidence": {"$ref": "#/$defs/evidence"},
        "semantic_structure_evidence": {"$ref": "#/$defs/evidence"},
        "visual_container_observed": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "evidence_status": {"type": "string"},
        "render_strategy": {"enum": ["reuse", "semantic_redraw", "reference_only", "generated", "generic_rectangle", "placeholder", "todo"]}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "PLANNED_NOT_OBSERVED"]},
        "observed": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "details": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
