{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/whole-course/external-source-research.schema.json",
  "title": "External Source Research",
  "type": "object",
  "required": ["schema_version", "research_status", "research_gaps", "sources", "conflicts"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "research_status": {"enum": ["USER_SOURCE_SUFFICIENT", "COMPLETED", "completed", "EXTERNAL_RESEARCH_DISABLED_BY_USER", "EXTERNAL_RESEARCH_UNAVAILABLE"]},
    "research_gaps": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "authority_trust_model": {"$ref": "#/$defs/authority_trust_model"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_url", "source_title", "selected", "origin", "origin_type"],
      "properties": {
        "source_url": {"type": ["string", "null"]},
        "source_title": {"type": ["string", "null"]},
        "selected": {"type": "boolean"},
        "origin": {"type": "string"},
        "authority_status": {"enum": ["VERIFIED_OFFICIAL", "VERIFIED_ACADEMIC", "ASSESSED_REFERENCE", "UNVERIFIED_OFFICIAL_CLAIM", "UNKNOWN"]},
        "authority_status_reason": {"type": ["string", "null"]},
        "verified_metadata": {"type": "object"},
        "evidence_origin": {"type": "object"},
        "origin_type": {"enum": ["external-authoritative", "external-reference"]},
        "license_note": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "authority_trust_model": {
      "type": "object",
      "properties": {
        "layers": {"const": ["CLAIMED", "OBSERVED_METADATA", "VERIFIED_IDENTITY"]},
        "statuses": {"type": "array", "items": {"type": "string"}},
        "policy": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
