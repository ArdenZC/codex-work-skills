{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-work-skills.local/whole-course/whole-course-contact-sheet.schema.json",
  "title": "Whole-Course Contact-Sheet Evidence",
  "type": "object",
  "required": ["schema_version", "report_type", "status", "thumbnail_count", "screenshot_count", "fallback_count", "browser_rendered"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "report_type": {"const": "whole_course_contact_sheets"},
    "status": {"enum": ["PASS", "FAIL", "DEGRADED", "NOT_RUN"]},
    "thumbnail_count": {"type": "integer", "minimum": 0},
    "screenshot_count": {"type": "integer", "minimum": 0},
    "fallback_count": {"type": "integer", "minimum": 0},
    "browser_rendered": {"type": "boolean"},
    "browser_failures": {"type": "array"}
  },
  "additionalProperties": true
}
